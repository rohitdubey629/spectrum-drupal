{#
/**
 * @file
 * Mega menu column — molecule (SDC: spectrum:mega-menu-column).
 *
 * Props:
 * - heading: column heading (menu level 2). Optional.
 * - heading_url: makes the heading a link. Optional.
 * - links: list of { title, url } (menu level 3).
 *
 */
#}
{# Debug: uncomment to inspect the props this component receives. #}
{# {{ dump({ heading: heading, heading_url: heading_url, links: links }) }} #}

<div class="mega-menu-column">
  {% if heading %}
    <p class="mega-menu-column__heading">
      {% if heading_url %}
        <a class="mega-menu-column__heading-link" href="{{ heading_url }}">{{ heading }}</a>
      {% else %}
        {{ heading }}
      {% endif %}
    </p>
  {% endif %}

  {% if links %}
    <ul class="mega-menu-column__list">
      {% for link in links %}
        <li class="mega-menu-column__item">
          <a class="mega-menu-column__link" href="{{ link.url }}">{{ link.title }}</a>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</div>
