{% set title_tag = title_tag|default('h3') %}

<article class="resource-card">
  <div class="resource-card__image">
    {% if image_url %}
      <img src="{{ image_url }}" alt="{{ image_alt|default('') }}" loading="lazy">
    {% endif %}
  </div>

  <div class="resource-card__content">
    <{{ title_tag }} class="resource-card__title">{{ title }}</{{ title_tag }}>
    {% if summary %}
      <p class="resource-card__summary">{{ summary }}</p>
    {% endif %}
    {# The link covers the whole card (see .resource-card__link::after). #}
    <a class="resource-card__link" href="{{ url }}">
      {{ link_text|default('View more'|t) }}<span class="visually-hidden">: {{ title }}</span>
      {% include 'spectrum:svg-icon' with { name: 'arrow-right', size: 16, modifier: 'resource-card__arrow' } only %}
    </a>
  </div>
</article>
