{#
/**
 * @file
 * Main navigation menu → Primary nav organism (SDC).
 *
 * Admin: Structure → Menus → Main navigation.
 *   Level 1 → top item            (About, Products, …)
 *   Level 2 → mega menu column    (Laser Wire Markers, …) — its link is the column heading
 *   Level 3 → link in the column  (Nova 1000, …)
 * Level-2 items without children are grouped into one column without a
 * heading.
 *
 * "Explore Our … →" link on top of a panel: fill in the level-1 menu link's
 * Description field (e.g. "Explore Our Products"); it links to the item's URL.
 *
 * The Drupal menu tree is turned into plain arrays of strings here, so the SDC
 * props validate and the data has the same shape as the Storybook sample
 * (components/03-organisms/primary-nav/primary-nav.yml).
 *
 * Block settings needed (Block layout → Main navigation → Configure):
 * "Number of levels to display" = 3 and "Expand all menu links" checked.
 */
#}
{# Debug: uncomment to see the raw Drupal menu tree. #}
{# {{ dump(items) }} #}

{% set nav_items = [] %}

{% for item in items %}
  {% set columns = [] %}
  {% set loose_links = [] %}

  {% for child in item.below %}
    {% if child.below %}
      {# Level 2 with children → a column with a heading. #}
      {% set links = [] %}
      {% for grandchild in child.below %}
        {% set links = links|merge([{ title: '' ~ grandchild.title, url: grandchild.url.toString() }]) %}
      {% endfor %}
      {% set columns = columns|merge([{ heading: '' ~ child.title, heading_url: child.url.toString(), links: links }]) %}
    {% else %}
      {# Level 2 without children → collected into one heading-less column. #}
      {% set loose_links = loose_links|merge([{ title: '' ~ child.title, url: child.url.toString() }]) %}
    {% endif %}
  {% endfor %}

  {% if loose_links %}
    {% set columns = [{ heading: '', heading_url: '', links: loose_links }]|merge(columns) %}
  {% endif %}

  {% set explore_title = item.original_link.getDescription()|default('') %}

  {% set nav_items = nav_items|merge([{
    title: '' ~ item.title,
    url: item.url.toString(),
    active: item.in_active_trail,
    explore_title: '' ~ explore_title,
    explore_url: explore_title ? item.url.toString() : '',
    columns: columns,
  }]) %}
{% endfor %}

{# Debug: uncomment to see the data sent to the component. #}
{# {{ dump(nav_items) }} #}

{% include 'spectrum:primary-nav' with {
  items: nav_items,
  label: 'Main',
} only %}
